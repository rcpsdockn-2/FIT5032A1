# Copy to .env.local and fill in the Web app configuration from Firebase Console.
# VITE_ values are included in the browser bundle. Never put server secrets here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Production only: same-origin function rewrite or HTTPS endpoint. Never localhost.
VITE_PLACES_FUNCTION_URL=

# Server only: never prefix these email settings with VITE_.
RESEND_API_KEY=
EMAIL_FROM=CycleWise <onboarding@resend.dev>
EMAIL_ALLOWED_RECIPIENTS=
FIREBASE_PROJECT_ID=
